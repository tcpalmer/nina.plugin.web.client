{
  "author": {
    "name": "Tom Palmer",
    "url": "https://github.com/tcpalmer/nina.plugin.web.client"
  },
  "keywords": [
    "react",
    "reactjs",
    "webpack"
  ],
  "license": "Mozilla Public 2.0",
  "name": "nina.plugin.web.client",
  "version": "1.0.0",
  "description": "NINA Web client",
  "dependencies": {
    "@rsuite/icons": "^1.4.1",
    "consola": "^2.15.3",
    "luxon": "^2.5.2",
    "mathjs": "^10.6.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-image-lightbox": "^5.1.4",
    "recharts": "^2.15.4",
    "rsuite": "^5.83.4",
    "rsuite-table": "^5.19.2",
    "schema-typed": "^2.4.2",
    "uuid": "^8.3.2"
  },
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "start": "./startDevServer.sh",
    "build": "NODE_ENV=production webpack --config config/webpack.prod.js",
    "build-staging": "NODE_ENV=production webpack --config config/webpack.stag.js",
    "prettify": "npx prettier \"**/*.*(js|jsx)\" --ignore-path=.prettierignore --write",
    "lint": "eslint src --ext .js,.jsx && npm run prettify",
    "lint-fix": "eslint src --ext .js,.jsx --fix && npm run prettify",
    "release": "bash scripts/release.sh",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx lint-staged --verbose"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.4.3",
    "@svgr/webpack": "^5.5.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^27.5.1",
    "babel-loader": "^8.4.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^9.1.0",
    "css-loader": "^6.11.0",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "dotenv-webpack": "^7.1.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^7.0.4",
    "jest": "^27.5.1",
    "less": "^4.9.1",
    "less-loader": "^10.2.0",
    "lint-staged": "^11.2.6",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^2.8.8",
    "react-refresh": "^0.9.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^3.11.3",
    "webpack-merge": "^5.10.0",
    "zip-webpack-plugin": "^4.0.3"
  }
}
